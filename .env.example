# FRED API (free): https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=your_fred_api_key_here

# Gmail SMTP — use an App Password, NOT your regular password
# Enable at: https://myaccount.google.com/apppasswords
GMAIL_USER=your_email@gmail.com
GMAIL_APP_PASSWORD=xxxx_xxxx_xxxx_xxxx

# Google Places API (optional — degrades to curated list if absent)
# Enable at: https://console.cloud.google.com → Places API
GOOGLE_PLACES_API_KEY=your_google_places_api_key_here
